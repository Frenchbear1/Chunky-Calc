{
  "name": "Chunky Calc",
  "short_name": "Chunky Calc",
  "description": "A tactile, customizable calculator with scientific functions, calculation history, and sound.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
